# 统一换行符：仓库内一律使用 LF
#
# 这一点对 OpenWrt 插件是**必须**的，不是可选项：
# 本项目的 init.d 脚本、uci-defaults 脚本、shell 库都是无后缀的 Linux 脚本，
# 一旦被转成 CRLF，装到路由器上会因 shebang 变成 `#!/bin/sh\r` 而无法执行。
* text=auto eol=lf

# 文本文件显式声明
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 无后缀的脚本与配置（OpenWrt 惯例，位于包目录的 root/ 下）—— 必须 LF
luci-app-vnt2web/root/etc/init.d/*            text eol=lf
luci-app-vnt2web/root/etc/uci-defaults/*      text eol=lf
luci-app-vnt2web/root/etc/config/*            text eol=lf
luci-app-vnt2web/root/usr/libexec/rpcd/*      text eol=lf
luci-app-vnt2web/root/usr/share/vnt2web/*     text eol=lf
luci-app-vnt2web/root/usr/share/luci/menu.d/* text eol=lf
luci-app-vnt2web/root/usr/share/rpcd/acl.d/*  text eol=lf

# 兜底：任何 root/ 下的文件都按 LF（万一以后新增无后缀脚本忘了声明）
root/**                text eol=lf

# Makefile 必须 LF（行尾的 \r 会破坏续行）
Makefile               text eol=lf
**/Makefile            text eol=lf

# 二进制文件不做任何转换
*.ipk   binary
*.apk   binary
*.png   binary
*.PNG   binary
*.jpg   binary
*.gz    binary
*.tgz   binary
*.zip   binary
